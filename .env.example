# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# Connexion PostgreSQL utilisée par Prisma.
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/typing_race?schema=public"

# Port du serveur (Railway le définit automatiquement). 3000 par défaut.
# En local, garder 3000 : c'est l'adresse de retour enregistrée chez GitHub et Discord.
PORT=3000

# Auth.js — secret de chiffrement des sessions (valeur différente en local et en production).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Adresse publique du site, utilisée par Auth.js pour les adresses de retour OAuth.
# PRODUCTION SEULEMENT (Railway) : https://typing-race-production-4a76.up.railway.app
# Laisser vide en local : http://localhost:3000 est détecté automatiquement.
# AUTH_URL=

# Application OAuth GitHub (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Application OAuth Discord (https://discord.com/developers/applications → OAuth2)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
